    "scripts/validate-r002-mvp-extraction.mjs",
    "scripts/compare-r002-normalized-output.mjs",
    "scripts/build-extraction-quality-summary.mjs",
    "scripts/run-r003-preflight.mjs",
    "scripts/validate-r003-preflight.mjs",
    "scripts/check-r003-token-compliance.mjs",
    "scripts/validate-r003-realization.mjs",
    "scripts/validate-r004-fidelity.mjs",
    "scripts/package-smoke.mjs",
    "scripts/validate-r006-evidence-truth.mjs",
    "scripts/validate-r006-url-lifecycle.mjs",
    "scripts/validate-r006-domain-provenance.mjs",
