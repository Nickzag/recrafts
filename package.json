    "test:r001": "node --test tests/r001-validator.test.mjs",
    "validate:r002": "node scripts/validate-r002-mvp-extraction.mjs",
    "validate:r003-preflight": "node scripts/validate-r003-preflight.mjs",
    "validate:r003-realization": "node scripts/validate-r003-realization.mjs examples/golden-candidates/crafts-ui-multi-image/realizations/r003b-v2",
    "validate:r004": "node scripts/validate-r004-fidelity.mjs examples/golden-candidates/crafts-ui-multi-image/fidelity/r004-v2",
    "build:r005": "node scripts/build-r005-release-candidate.mjs",
    "validate:r005": "node scripts/validate-r005-release-candidate.mjs release-candidates/recrafts-0.3.0-rc.1-build5",
    "validate:r006": "node --test tests/r006-evidence-truth.test.mjs",
    "validate:r007": "node --test tests/r007-contracts.test.mjs tests/r007-package-evolution.test.mjs",
