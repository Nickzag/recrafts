{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recrafts.local/benchmarks/schemas/source-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_pack_id", "source_url", "capture_id", "capture_status", "captured_at", "viewport", "sources", "redistribution_policy"],
  "properties": {
    "corpus_id": { "type": "string", "minLength": 1 },
    "source_pack_id": { "type": "string", "minLength": 1 },
    "source_pack_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "parent_source_pack_id": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "format": "uri" },
    "capture_id": { "type": "string", "minLength": 1 },
    "capture_status": { "enum": ["complete", "stable-static", "partial", "failed"] },
    "captured_at": { "type": "string", "format": "date-time" },
    "viewport": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } } },
    "capture_scope": { "type": "string" },
    "missing_sources": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "intentional_exclusions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "scope_decision_id": { "type": "string", "minLength": 1 },
    "redistribution_policy": { "const": "metadata-and-hashes-only" },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "section_ref", "local_path", "sha256", "dimensions", "media_type", "redistribution_status"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "section_ref": { "type": "string", "minLength": 1 },
          "local_path": { "type": "string", "minLength": 1 },
          "source_url": { "type": "string", "format": "uri" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "dimensions": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } } },
          "media_type": { "type": "string", "pattern": "^image/" },
          "redistribution_status": { "const": "local-only" }
        }
      }
    }
  }
}
