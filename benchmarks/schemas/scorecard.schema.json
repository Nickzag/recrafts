{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recrafts.local/benchmarks/schemas/scorecard.schema.json",
  "type": "object", "additionalProperties": false, "required": ["rubric_version", "automatic_weight", "human_weight", "automatic_modules", "human_modules", "thresholds"],
  "properties": {
    "rubric_version": { "type": "string" }, "automatic_weight": { "const": 75 }, "human_weight": { "const": 25 },
    "automatic_modules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/module" } },
    "human_modules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/module" } },
    "thresholds": { "type": "object" }
  },
  "$defs": { "module": { "type": "object", "additionalProperties": false, "required": ["module_id", "weight", "mode"], "properties": { "module_id": { "type": "string" }, "weight": { "type": "number", "minimum": 0 }, "mode": { "enum": ["automatic", "automatic-hard-gate", "human"] } } } }
}
