{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recrafts.local/contracts/host-analysis.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture_label", "prepared_analysis_id", "execution", "findings", "tokens", "components"],
  "properties": {
    "fixture_label": { "type": "string", "minLength": 1 },
    "prepared_analysis_id": { "type": "string", "pattern": "^prepared-" },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_agent", "engine", "vision_capability", "performed_at"],
      "properties": {
        "host_agent": { "type": "string", "minLength": 1 },
        "engine": { "type": "string", "minLength": 1 },
        "vision_capability": { "const": true },
        "performed_at": { "type": "string", "minLength": 1 }
      }
    },
    "source_classifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "classification", "scope", "confidence", "evidence_refs"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "classification": { "enum": ["excluded-sensitive-content", "user-generated-content", "marketing-surface", "canonical-product-ui", "unknown"] },
          "scope": { "enum": ["workspace", "project", "surface", "selection", "block"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "regions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "classification", "scope", "confidence", "evidence_refs"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "classification": { "enum": ["excluded-sensitive-content", "user-generated-content", "marketing-surface", "canonical-product-ui", "unknown"] },
                "scope": { "enum": ["workspace", "project", "surface", "selection", "block"] },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "observation", "scope", "confidence", "evidence_refs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "observation": { "type": "string", "minLength": 1 },
          "scope": { "enum": ["workspace", "project", "surface", "selection", "block"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "value", "scope", "status", "confidence", "evidence_refs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "value": {},
          "scope": { "enum": ["workspace", "project", "surface", "selection", "block"] },
          "status": { "enum": ["observed", "inferred", "suggested", "confirmed"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "scope", "confidence", "evidence_refs"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "anatomy": { "type": "array", "items": { "type": "string" } },
          "variants": { "type": "array", "items": { "type": "string" } },
          "states": { "type": "array", "items": { "type": "string" } },
          "scope": { "enum": ["workspace", "project", "surface", "selection", "block"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "grid_rules": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "rule_type", "constraints", "scope", "status", "confidence", "evidence_refs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 }, "rule_type": { "type": "string", "minLength": 1 }, "constraints": { "type": "object" },
          "scope": { "enum": ["workspace", "project", "surface", "selection", "block"] }, "status": { "enum": ["observed", "inferred", "suggested"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "conflict_class", "domain", "severity", "impact", "candidate_refs", "evidence_refs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "conflict_class": { "enum": ["dom-vs-screenshot", "css-vs-computed-style", "multi-image-token-conflict", "scope-conflict", "component-state-conflict", "grid-rule-conflict", "stale-vs-current"] },
          "domain": { "enum": ["token", "component", "grid-rule", "layout-rule", "visual-grammar", "evidence"] },
          "severity": { "enum": ["low", "medium", "high"] }, "impact": { "type": "string", "minLength": 1 },
          "candidate_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    }
  }
}
