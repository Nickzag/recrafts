{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recrafts.local/contracts/source-observation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_id", "domain", "value", "source_scope", "evidence_refs", "claim_refs", "confidence", "source_specificity", "portability_risk"],
  "properties": {
    "observation_id": { "type": "string", "minLength": 1 },
    "domain": { "enum": ["color", "typography", "layout", "shape", "motion", "topology", "motif", "image", "icon"] },
    "value": {},
    "source_scope": { "type": "string", "minLength": 1 },
    "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "claim_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "confidence": { "enum": ["low", "medium", "high"] },
    "source_specificity": { "enum": ["low", "medium", "high"] },
    "portability_risk": { "enum": ["low", "medium", "high"] }
  }
}
