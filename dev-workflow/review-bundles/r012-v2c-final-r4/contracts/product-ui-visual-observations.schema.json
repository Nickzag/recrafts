{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recrafts.local/contracts/product-ui-visual-observations.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_version", "prepared_visual_recovery_id", "execution", "screens", "regions", "measurements", "state_aware_colors", "source_observed_visual_tokens", "component_instances", "cross_screen_recurrence", "unknowns", "evidence_weighting"],
  "properties": {
    "schema_version": { "const": "3.1.0" },
    "protocol_version": { "const": "1.2" },
    "prepared_visual_recovery_id": { "type": "string", "pattern": "^prepared-visual-" },
    "execution": { "type": "object", "additionalProperties": false, "required": ["host_agent", "engine", "vision_capability", "performed_at", "evidence_class"], "properties": { "host_agent": { "type": "string", "minLength": 1 }, "engine": { "type": "string", "minLength": 1 }, "vision_capability": { "const": true }, "performed_at": { "type": "string", "minLength": 1 }, "evidence_class": { "enum": ["codex-session-fixture", "live-provider", "real-user", "controlled-fixture"] } } },
    "screens": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["screen_id", "source_id", "screen_family", "source_role", "authority", "platform", "viewport", "dimensions", "source_sha256", "visible_states", "evidence_refs"], "properties": { "screen_id": { "type": "string" }, "source_id": { "type": "string" }, "screen_family": { "type": "string" }, "source_role": { "type": "string" }, "authority": { "enum": ["tier-a", "tier-b", "tier-c", "tier-d", "untrusted"] }, "platform": { "type": "string" }, "viewport": { "type": "string" }, "dimensions": { "type": "object", "required": ["width", "height"], "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } } }, "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "visible_states": { "type": "array", "items": { "type": "string" } }, "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } } } } },
    "regions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/region" } },
    "measurements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/measurement" } },
    "state_aware_colors": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["observation_id", "screen_id", "region_id", "state", "role", "value", "evidence_refs", "certainty", "status"], "properties": { "observation_id": { "type": "string" }, "screen_id": { "type": "string" }, "region_id": { "type": "string" }, "state": { "enum": ["default", "selected", "active", "hover", "focus", "disabled", "available-option", "marketing", "user-content", "template-content", "unknown"] }, "role": { "type": "string" }, "value": {}, "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "certainty": { "enum": ["measured", "estimated", "model-inferred", "unknown"] }, "status": { "enum": ["observed", "corroborated", "single-screen", "conflicted", "unknown"] } } } },
    "source_observed_visual_tokens": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["observation_token_id", "role", "observed_values", "screen_refs", "region_refs", "measurement_refs", "state", "scope", "cross_screen_recurrence", "confidence", "status"], "properties": { "observation_token_id": { "type": "string" }, "role": { "type": "string" }, "observed_values": { "type": "array", "minItems": 1 }, "screen_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "region_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "measurement_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "state": { "type": "string" }, "scope": { "type": "string" }, "cross_screen_recurrence": { "type": "integer", "minimum": 0 }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "status": { "enum": ["observed", "corroborated", "single-screen", "conflicted", "unknown"] } } } },
    "component_instances": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["instance_id", "component_candidate", "screen_id", "region_id", "state", "evidence_refs", "confidence", "status"], "properties": { "instance_id": { "type": "string" }, "component_candidate": { "type": "string" }, "screen_id": { "type": "string" }, "region_id": { "type": "string" }, "state": { "type": "string" }, "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "status": { "enum": ["observed", "corroborated", "single-screen", "unknown"] } } } },
    "cross_screen_recurrence": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["recurrence_id", "component_candidate", "screen_refs", "region_refs", "recurrence_count", "evidence_refs", "status"], "properties": { "recurrence_id": { "type": "string" }, "component_candidate": { "type": "string" }, "screen_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "region_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "recurrence_count": { "type": "integer", "minimum": 1 }, "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "status": { "enum": ["observed", "corroborated", "single-screen", "unknown"] } } } },
    "unknowns": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["unknown_id", "question", "screen_refs", "impact", "status"], "properties": { "unknown_id": { "type": "string" }, "question": { "type": "string" }, "screen_refs": { "type": "array", "items": { "type": "string" } }, "impact": { "type": "string" }, "status": { "const": "unknown" } } } },
    "evidence_weighting": { "type": "object", "additionalProperties": false, "required": ["tiers", "application_visual_token_source_counts", "gates", "status"], "properties": { "tiers": { "type": "array", "minItems": 3 }, "application_visual_token_source_counts": { "type": "object" }, "gates": { "type": "object" }, "status": { "enum": ["pass", "blocked"] } } }
  },
  "$defs": {
    "region": { "type": "object", "additionalProperties": false, "required": ["region_id", "screen_id", "coordinates", "crop_sha256", "role", "scope", "state", "parent_region_id", "component_candidate", "measurement_refs", "confidence", "classification_method", "review_status"], "properties": { "region_id": { "type": "string" }, "screen_id": { "type": "string" }, "coordinates": { "type": "object", "required": ["x", "y", "width", "height", "normalized"], "properties": { "x": { "type": "number", "minimum": 0 }, "y": { "type": "number", "minimum": 0 }, "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 }, "normalized": { "type": "array", "minItems": 4, "maxItems": 4 } } }, "crop_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "role": { "type": "string" }, "scope": { "type": "string" }, "state": { "type": "string" }, "parent_region_id": { "type": ["string", "null"] }, "component_candidate": { "type": ["string", "null"] }, "measurement_refs": { "type": "array" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "classification_method": { "type": "string" }, "review_status": { "type": "string" }, "evidence_refs": { "type": "array" } } },
    "measurement": { "type": "object", "additionalProperties": false, "required": ["measurement_id", "region_id", "property", "value", "unit", "method", "certainty", "sample_location", "tolerance", "evidence_refs", "review_status"], "properties": { "measurement_id": { "type": "string" }, "region_id": { "type": "string" }, "property": { "type": "string" }, "value": {}, "unit": { "type": "string" }, "method": { "type": "string" }, "certainty": { "type": "string" }, "sample_location": { "type": "object" }, "tolerance": {}, "evidence_refs": { "type": "array" }, "review_status": { "type": "string" } } }
  }
}
