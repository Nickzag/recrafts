{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recrafts.local/contracts/product-ui-screen-region.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["region_id", "screen_id", "coordinates", "crop_sha256", "role", "scope", "state", "parent_region_id", "component_candidate", "measurement_refs", "confidence", "classification_method", "review_status"],
  "properties": {
    "region_id": { "type": "string", "minLength": 1 },
    "screen_id": { "type": "string", "minLength": 1 },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height", "normalized"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "normalized": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0, "maximum": 1 } }
      }
    },
    "crop_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "role": { "enum": ["platform-chrome", "window-chrome", "application-sidebar", "navigation-row", "selected-navigation-row", "top-toolbar", "content-header", "document-preview", "list-row", "selected-list-row", "canvas-or-document", "inspector", "overlay", "dialog", "sheet", "control", "icon", "feedback", "empty-state", "loading-state", "user-content", "template-content", "unknown"] },
    "scope": { "enum": ["application-chrome", "workspace-shell", "navigation", "editor-chrome", "canvas-or-document-content", "inspector", "review-and-evidence", "overlay", "system-feedback", "marketing-brand", "user-content", "template-content", "platform-chrome", "unknown"] },
    "state": { "enum": ["default", "selected", "active", "hover", "focus", "disabled", "available-option", "marketing", "user-content", "template-content", "unknown"] },
    "parent_region_id": { "type": ["string", "null"] },
    "component_candidate": { "type": ["string", "null"] },
    "measurement_refs": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "classification_method": { "enum": ["Host-vision", "manual-review", "geometry", "cross-screen-comparison", "unknown"] },
    "review_status": { "enum": ["unreviewed", "reviewed", "corrected", "blocked"] },
    "evidence_refs": { "type": "array", "items": { "type": "string" } }
  }
}
