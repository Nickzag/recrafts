{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recrafts/realization-package",
  "type": "object",
  "required": ["capture_id", "analysis_id", "package_id", "skill_version", "runtime_version", "schema_version", "capture_adapter_version", "host_agent", "model", "prompt_hash", "configuration_hash", "sources"],
  "properties": {
    "capture_id": { "type": "string", "pattern": "^capture-" },
    "analysis_id": { "type": "string", "pattern": "^analysis-" },
    "package_id": { "type": "string", "pattern": "^package-" },
    "schema_version": { "const": "2.1.0" },
    "sources": { "type": "array", "minItems": 1 }
  },
  "additionalProperties": true
}
